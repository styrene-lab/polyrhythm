kit crocell {
  name "CrocellKit"
  kit_xml "~/.local/share/drumgizmo/kits/CrocellKit/CrocellKit_full.xml"
  sample_params "close=0.10,diverse=0.12,random=0.02"

  map kick.main note 36 instr KDrumR
  map snare.head note 38 instr Snare
  map snare.rim note 37 instr SnareRim
  map snare.rimshot note 40 instr SnareRimShot
  map tom.1.head note 48 instr Tom1
  map tom.2.head note 47 instr Tom2
  map tom.3.head note 43 instr FTom1
  map tom.4.head note 41 instr FTom2
  map hihat.closed note 42 instr HihatClosed
  map hihat.semi_open note 80 instr HihatSemiOpen
  map hihat.open note 46 instr HihatOpen
  map hihat.pedal note 44 instr HihatPedal
  map ride.bow note 51 instr RideR
  map ride.bell note 53 instr RideRBell
  map ride.edge note 51 instr RideR
  map crash.1.bow note 49 instr CrashL
  map crash.1.edge note 49 instr CrashL
  map crash.1.choke note 56 instr CrashLStopped
  map crash.2.bow note 57 instr CrashR
  map crash.2.choke note 75 instr CrashRStopped
}
